# Copie este arquivo para ".env" (sem o .example) e preencha. O ".env" NUNCA vai para o GitHub.
# No Render, estes valores vão no painel: Environment > Add Environment Variable.

# Chave que assina o cookie de login. Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = modo servidor (cookie só por HTTPS, HSTS, SECRET_KEY obrigatória). Use 1 no Render; deixe vazio no seu PC.
PRODUCAO=

# 0 = esconde "Criar Conta" (ficam só o Acesso Mestre e a conta de demonstração). 1 = cadastro liberado.
PERMITIR_CADASTRO=1

# Conta de demonstração opcional, recriada a cada início do servidor (útil no Render grátis, onde os arquivos somem).
CONTA_DEMO_EMAIL=
CONTA_DEMO_SENHA=

# Só no seu computador: 1 liga a recarga automática e a página de erros detalhada. NUNCA no Render.
FLASK_DEBUG=0
